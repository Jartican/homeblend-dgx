# Copy to ~/.config/exocortex/stack.env and chmod 600.
# Non-secret defaults may be changed here; never commit the populated file.

MODEL_QUALITY=qwen3.8:27b
MODEL_FAST_SOURCE=nvidia/Qwen3-8B-NVFP4
MODEL_FAST_ALIAS=exocortex-chat-fast
MODEL_QUALITY_ALIAS=exocortex-agent-quality

# Translation-mode speech recognition. Preload with
# dgx-bootstrap/preload-multilingual-stt.sh before deploying Voice Core.
SPEACHES_MULTILINGUAL_STT_MODEL=Systran/faster-whisper-small

OLLAMA_URL=http://127.0.0.1:11434
LITELLM_HOST=127.0.0.1
LITELLM_PORT=4000
LITELLM_KEY=replace-with-a-random-local-key
LITELLM_VERSION=1.98.0

VLLM_IMAGE=vllm/vllm-openai@sha256:0a51ea5b4ae2dc5d81890e5173f54203d2a3ae0cfffe51b8fd2afd4391bfd967
VLLM_CONTAINER=vllm-qwen3-8b
VLLM_MODEL_SOURCE=nvidia/Qwen3-8B-NVFP4
VLLM_SERVED_MODEL=exocortex-chat-fast
VLLM_BIND=127.0.0.1
VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.25
VLLM_URL=http://127.0.0.1:8001/v1

POSTGRES_IMAGE=pgvector/pgvector@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b
POSTGRES_CONTAINER=spark-postgres
POSTGRES_DB=exocortex
POSTGRES_USER=exocortex
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DATA_DIR=$HOME/postgres_data
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Raw conversation logging is gated on encrypted PostgreSQL storage.
DEPLOY_EXOCORTEX_GATEWAY=1
REQUIRE_ENCRYPTED_POSTGRES=1
ALLOW_UNENCRYPTED_GATEWAY_TEST=0
EXOCORTEX_GATEWAY_HOST=127.0.0.1
EXOCORTEX_GATEWAY_PORT=4010
DEPLOY_CLAUDE_SMART_ROUTER=1
DEPLOY_HOME_BLEND_ROUTER=1

# Private phone/Omi voice stack. Fresh installs deploy STT/TTS, neural wake,
# denoising, and the loopback Voice Core gateway. Application authentication
# remains fail-closed until a client is enrolled; never place its token here.
DEPLOY_PRIVATE_VOICE_STACK=1
DEPLOY_SERVER_DENOISER=1
DEPLOY_NEURAL_WAKE=1
DEPLOY_SPEAKER_AWARENESS=0
DEPLOY_SORTFORMER_DIARIZATION=0
EXOCORTEX_VOICE_NETWORK=exocortex-voice
VOICE_GATEWAY_PORT=8791
VOICE_REALTIME_ENABLED=1
VOICE_REALTIME_ALLOW_TAILNET_UNAUTHENTICATED=false
VOICE_REALTIME_MAX_SESSION_SECONDS=3600
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-small.en
SPEACHES_FAST_STT_MODEL=Systran/faster-whisper-tiny.en
SPEACHES_WAKE_STT_MODEL=Systran/faster-whisper-tiny.en
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_TTS_VOICE=af_heart
VOICE_WAKE_WORD=Gauss
VOICE_WAKE_ALIASES=gauss,gaus,goss,gouse,gauze

# Speaker recognition and diarization require the separately created and
# interactively unlocked LUKS biometric vault. They are advisory provenance,
# never authentication, and remain disabled until explicitly enabled above.
EXOCORTEX_BIOMETRIC_VAULT_SIZE_MIB=2048

# Shadow-only vLLM Semantic Router challenger. It is loopback-bound and does
# not replace HomeBlend. Enable deliberately after the core stack is healthy.
DEPLOY_VLLM_SEMANTIC_ROUTER=0
VLLM_SR_IMAGE=ghcr.io/vllm-project/semantic-router/vllm-sr@sha256:13f7bcfc5f2080682acf1458da9cf077d84dfa0bd7b95c9ab7544c754fec3b94
VLLM_SR_CONTAINER=exocortex-vllm-sr-v06
VLLM_SR_ENVOY_CONTAINER=exocortex-vllm-sr-v06-envoy
VLLM_SR_ENVOY_IMAGE=envoyproxy/envoy@sha256:cfc0678bc03cca19cbb031688acb31d510bff501ff97e163026a375fe0515d69
VLLM_SR_BIND=127.0.0.1
VLLM_SR_PORT=8899
VLLM_SR_MANAGEMENT_PORT=18080
VLLM_SR_LITELLM_BRIDGE_PORT=14000

OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:2391dd9495ec87257a200e70e66a4a77adc2d3a7fe15c07293078fb0c6a009c1
OPEN_WEBUI_CONTAINER=open-webui
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=12000
OPEN_WEBUI_SECRET_KEY=replace-with-a-random-secret
OPEN_WEBUI_NETWORK=exocortex-tools
OPEN_WEBUI_OPENAI_BASE_URL=http://vllm-qwen3-8b:8000/v1
OPEN_WEBUI_OPENAI_KEY=local-vllm
OPEN_WEBUI_MCP_URL=http://exocortex-mcp-gateway:8000/mcp
OPEN_WEBUI_ENABLE_OLLAMA_API=false

MCP_GATEWAY_IMAGE=exocortex/mcp-gateway:local
MCP_GATEWAY_BIND=127.0.0.1
MCP_GATEWAY_PORT=8766
MCP_GATEWAY_CONTAINER=exocortex-mcp-gateway
SEARXNG_IMAGE=ghcr.io/searxng/searxng@sha256:11a9b34cdc0b1ec2b991470a2762ecb5a1a531898289fb51dcd015260450729e
SEARXNG_CONTAINER=exocortex-searxng
SEARXNG_SECRET=replace-with-a-random-secret
WEB_SEARCH_RESULT_LIMIT=8
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_USER_AGENT=Exocortex-MCP/1.0
