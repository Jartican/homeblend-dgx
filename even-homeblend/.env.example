# API key for your chosen speech-to-text provider.
# Copy this file to `.env.local` and fill in your key. Never commit `.env.local`.
# Production: the phone must be signed into the same Tailscale tailnet.
VITE_VOICE_GATEWAY_URL=wss://voice-core.invalid/voice/v2/voice/realtime

# Local simulator alternative (run `npm run voice:tunnel` first):
# VITE_VOICE_GATEWAY_URL=ws://127.0.0.1:18791/v2/voice/realtime
